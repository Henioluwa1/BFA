# BFA Apartments Management System - Test Environment Configuration
# Template file with non-sensitive defaults for automated testing.
# Copy to backend/.env.test for local test runs.

NODE_ENV=test
PORT=5001
TEST_DB_ENGINE=postgres
DB_NAME=bfa_apartments_test_db
DB_NAME_TEST=bfa_apartments_test_db
TEST_DB_NAME=bfa_apartments_test_db

# Test connections are loopback-only. Never copy production/Aiven connection values here.
TEST_PGHOST=127.0.0.1
TEST_PGPORT=5432
TEST_PGDATABASE=bfa_apartments_test_db
TEST_PGUSER=postgres
# Set TEST_PGPASSWORD only when the local PostgreSQL instance requires it.

