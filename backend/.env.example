# ==============================================================================
# BFA Apartments Management System — Environment Configuration Template
# ==============================================================================

# Application Configuration
PORT=5000
NODE_ENV=development
APP_NAME=BFA Apartments Management System
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173
DB_ENGINE=postgres

# ------------------------------------------------------------------------------
# Database Provider: Aiven PostgreSQL (Recommended for Cloud / Render)
# ------------------------------------------------------------------------------
# Option A: Full PostgreSQL Connection URI (standard on Aiven and Render)
DATABASE_URL=postgres://avnadmin:REPLACE_WITH_AIVEN_PASSWORD@REPLACE_WITH_AIVEN_HOST:REPLACE_WITH_AIVEN_PORT/defaultdb?sslmode=require

# Option B: Discrete Parameters
PGHOST=REPLACE_WITH_AIVEN_HOST.aivencloud.com
PGPORT=REPLACE_WITH_AIVEN_PORT
PGDATABASE=defaultdb
PGUSER=avnadmin
PGPASSWORD=REPLACE_WITH_AIVEN_PASSWORD
PG_MAX_POOL=10
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECT_TIMEOUT_MS=10000

# Aiven PostgreSQL TLS / SSL Verification
# Pass either a mounted CA certificate file path OR a PEM string in an environment variable.
# rejectUnauthorized: true is strictly enforced for all remote Aiven connections.
PG_CA_PATH=certs/aiven-ca.pem
# PG_CA_CERT="-----BEGIN CERTIFICATE-----\n...\n-----END CERTIFICATE-----"

# ------------------------------------------------------------------------------
# Legacy / Fallback Database (MySQL / XAMPP / TiDB)
# ------------------------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bfa_apartments_db
DB_CONNECTION_LIMIT=10
DB_TLS=false

# ------------------------------------------------------------------------------
# Security & Tokens
# ------------------------------------------------------------------------------
JWT_SECRET=bfa_super_secret_jwt_key_development_only_change_in_prod_2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
