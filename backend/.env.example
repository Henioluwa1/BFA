# Application
PORT=5000
NODE_ENV=development
APP_NAME=BFA Apartments Management System
APP_URL=http://localhost:5000
FRONTEND_URL=http://localhost:5173

# Database (MySQL / XAMPP)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=bfa_apartments_db
DB_CONNECTION_LIMIT=10
# Optional managed database TLS (e.g. TiDB Cloud). Local XAMPP defaults to TLS off.
DB_TLS=false
# Set DB_TLS_CA to PEM content OR DB_TLS_CA_PATH to a mounted CA file when TLS is enabled.
# DB_TLS_CA=
# DB_TLS_CA_PATH=

# Security / Token Secrets
JWT_SECRET=bfa_super_secret_jwt_key_development_only_change_in_prod_2026
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173,http://localhost:5174,http://127.0.0.1:5173,http://127.0.0.1:5174

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
