# ==============================================================================
# BFA Apartments Management System — Production Environment Template
# ==============================================================================

# Application Environment
NODE_ENV=production
PORT=5000
APP_NAME=BFA Apartments Management System
APP_URL=https://api.bfagroup.com
FRONTEND_URL=https://app.bfagroup.com

# Production Database (MariaDB / MySQL 8.0+)
DB_HOST=mariadb
DB_PORT=3306
DB_USER=bfa_prod_user
DB_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_PRODUCTION_DB_PASSWORD
DB_ROOT_PASSWORD=REPLACE_WITH_HIGH_ENTROPY_ROOT_PASSWORD
DB_NAME=bfa_apartments_db
DB_CONNECTION_LIMIT=25
DB_QUEUE_LIMIT=0
DB_IDLE_TIMEOUT=60000
DB_CONNECT_TIMEOUT=10000

# Cryptographic Security
# Must be at least 32 characters, randomly generated (e.g., openssl rand -base64 32)
JWT_SECRET=REPLACE_WITH_SECURE_RANDOM_SHA256_STRING_AT_LEAST_32_CHARS
JWT_EXPIRES_IN=7d

# Production CORS Origin Whitelist (Comma-separated, no wildcards)
CORS_ORIGIN=https://app.bfagroup.com,https://bfagroup.com

# Production Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=1000
AUTH_RATE_LIMIT_MAX=20
BOOKING_RATE_LIMIT_MAX=60

# Production Super Admin Initial Bootstrap Credentials (seed:admin)
SUPER_ADMIN_NAME=BFA Super Admin
SUPER_ADMIN_EMAIL=admin@bfagroup.com
SUPER_ADMIN_PASSWORD=REPLACE_WITH_STRONG_INITIAL_SUPERADMIN_PASSWORD

# Currency Localization
DEFAULT_CURRENCY=NGN
CURRENCY_SYMBOL=₦
CURRENCY_LOCALE=en-NG
