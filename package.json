{
  "name": "bfa-apartments-management-system",
  "version": "1.0.0",
  "description": "BFA Apartments Management System — Multi-property enterprise property and reservation platform",
  "private": true,
  "scripts": {
    "dev": "npm run dev:all",
    "dev:all": "concurrently -k -n \"BACKEND,FRONTEND\" -c \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend",
    "db:migrate": "npm run db:migrate --prefix backend",
    "postinstall": "npm install --prefix backend && npm install --prefix frontend"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  },
  "keywords": [
    "apartments",
    "property-management",
    "hospitality",
    "bfa",
    "reservations"
  ],
  "author": "BFA Engineering Team",
  "license": "UNLICENSED"
}
